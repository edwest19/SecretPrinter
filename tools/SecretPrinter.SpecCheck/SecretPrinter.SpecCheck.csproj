<!--
  SecretPrinter.SpecCheck.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Checks that README.md and the code agree. References SecretPrinter.Spec for
  the attribute's type name and identifier pattern, so that renaming either
  cannot leave a stale copy behind in this tool.

  No NuGet package references. Assemblies are inspected through the base class
  library's reflection metadata APIs, which read attribute values without
  instantiating them - so scanning never runs code from the assembly being
  scanned.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.SpecCheck</RootNamespace>
    <AssemblyName>SecretPrinter.SpecCheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
