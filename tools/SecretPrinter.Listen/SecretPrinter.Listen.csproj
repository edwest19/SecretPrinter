<!--
  SecretPrinter.Listen.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  References the shared SecretPrinter.Dns library rather than carrying its own
  copy of the parser. No NuGet package references.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Listen</RootNamespace>
    <AssemblyName>SecretPrinter.Listen</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
  </ItemGroup>

</Project>
