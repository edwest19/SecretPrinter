<!--
  SecretPrinter.Probe.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Reads a printer's mDNS advertisement so the proxy can be built against
  measured values rather than guessed ones. No NuGet package references: this
  tool uses only the base class library plus the shared SecretPrinter.Dns
  project, so there is no third-party code to audit.

  The reference to SecretPrinter.Spec added by Claude (Anthropic model, Claude
  Opus 5.5) at the direction of Edwin West, 2026-10-06, for the one
  [Requirement] marker in AssemblyClaims.cs (REQ-SEC-016). SecretPrinter.Spec
  holds that attribute and nothing else. The sentence above still holds: no
  NuGet package, and now two projects of this repository.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Probe</RootNamespace>
    <AssemblyName>SecretPrinter.Probe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
