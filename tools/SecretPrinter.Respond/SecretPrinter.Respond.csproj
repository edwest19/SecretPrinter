<!--
  SecretPrinter.Respond.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  An experiment, not a component of the service. It measures whether mDNS
  responses can be sent while another responder holds port 5353, and whether an
  iOS client accepts a printer advertised without IPPS.

  Deliberately carries no [Requirement] markers: the requirements in README.md
  describe the service, and this tool will be superseded by it. Marking a
  throwaway experiment as implementing service requirements would make the
  coverage matrix say something untrue.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Respond</RootNamespace>
    <AssemblyName>SecretPrinter.Respond</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
  </ItemGroup>

</Project>
