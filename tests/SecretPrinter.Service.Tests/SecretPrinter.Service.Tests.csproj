<!--
  SecretPrinter.Service.Tests.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Checks the claims about what the service does NOT do, by reading the compiled
  metadata of every assembly of the service. References the service project,
  which transitively brings every one of them into this project's output
  directory where the scan can find them. (This read "every shipped assembly"
  until 2026-10-06, when the probe, which is in every release too, was given
  tests of its own; see the last paragraph.)

  Also checks two decisions ServiceHost makes without opening a socket: which
  interfaces each of its two mDNS sockets joins, and how each job's printer
  lookup is logged (ServiceHostTests.cs). That paragraph added by Claude
  (Anthropic model, Claude Opus 5) at the direction of Edwin West, 2026-09-16.

  Also checks what the probe cannot do (ProbeClaimsTests.cs, REQ-SEC-016), the
  same way. The reference to the probe's project is there so that its assembly
  is in this project's output directory to be read; no test calls into it. That
  paragraph and the reference added by Claude (Anthropic model, Claude Opus 5.5)
  at the direction of Edwin West, 2026-10-06.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Service.Tests</RootNamespace>
    <AssemblyName>SecretPrinter.Service.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Service/SecretPrinter.Service.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
    <ProjectReference Include="../SecretPrinter.TestKit/SecretPrinter.TestKit.csproj" />
    <ProjectReference Include="../../tools/SecretPrinter.Probe/SecretPrinter.Probe.csproj" />
  </ItemGroup>

</Project>
