<!--
  SecretPrinter.Service.Tests.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Checks the claims about what the service does NOT do, by reading the compiled
  metadata of every shipped assembly. References the service project, which
  transitively brings every shipped assembly into this project's output
  directory where the scan can find them.

  Also checks two decisions ServiceHost makes without opening a socket: which
  interfaces each of its two mDNS sockets joins, and how each job's printer
  lookup is logged (ServiceHostTests.cs). That paragraph added by Claude
  (Anthropic model, Claude Opus 5) at the direction of Edwin West, 2026-09-16.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Service.Tests</RootNamespace>
    <AssemblyName>SecretPrinter.Service.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Service/SecretPrinter.Service.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
    <ProjectReference Include="../SecretPrinter.TestKit/SecretPrinter.TestKit.csproj" />
  </ItemGroup>

</Project>
