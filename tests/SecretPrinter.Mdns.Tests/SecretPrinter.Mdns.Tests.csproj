<!--
  SecretPrinter.Mdns.Tests.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Tests for the mDNS socket layer.

  This is a console application, not a `dotnet test` project, and carries NO
  NuGet package references. REQ-SEC-009 requires every dependency to be the base
  class library or a project in this repository; a test framework would be the
  first exception to that. The harness lives in tests/SecretPrinter.TestKit and
  is shared by every test project. Run with `dotnet run`; it exits 0 on success
  and 1 on failure, so CI can gate on it directly.

  The assembly name ends in '.Tests', which is how SecretPrinter.SpecCheck
  recognises [Requirement] markers here as TEST coverage rather than
  implementation coverage.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Mdns.Tests</RootNamespace>
    <AssemblyName>SecretPrinter.Mdns.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Mdns/SecretPrinter.Mdns.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
    <ProjectReference Include="../SecretPrinter.TestKit/SecretPrinter.TestKit.csproj" />
  </ItemGroup>

</Project>
