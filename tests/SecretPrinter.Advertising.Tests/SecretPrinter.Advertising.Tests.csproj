<!--
  SecretPrinter.Advertising.Tests.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Tests for the advertisement builder, driven by the ET-3760's real measured TXT
  records. Needs no network and no hardware, so these run everywhere.

  Run with 'dotnet run', passing a results path; exits 0 on success, 1 on failure.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Advertising.Tests</RootNamespace>
    <AssemblyName>SecretPrinter.Advertising.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Advertising/SecretPrinter.Advertising.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
    <ProjectReference Include="../SecretPrinter.TestKit/SecretPrinter.TestKit.csproj" />
  </ItemGroup>

</Project>
