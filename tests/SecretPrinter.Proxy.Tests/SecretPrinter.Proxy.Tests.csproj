<!--
  SecretPrinter.Proxy.Tests.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Tests for the print path, driven through in-memory streams. Two of them are
  structural: one reads the proxy assembly's metadata to confirm it references
  no file-writing type, the other reflects over the observer interface to
  confirm no method can accept payload bytes.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Proxy.Tests</RootNamespace>
    <AssemblyName>SecretPrinter.Proxy.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Proxy/SecretPrinter.Proxy.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
    <ProjectReference Include="../SecretPrinter.TestKit/SecretPrinter.TestKit.csproj" />
  </ItemGroup>

</Project>
