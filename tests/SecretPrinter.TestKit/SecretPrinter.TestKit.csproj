<!--
  SecretPrinter.TestKit.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  The shared test harness: assertions, [TestCase] discovery, the results file
  that SecretPrinter.SpecCheck reads, and a fake IMdnsTransport so components
  that use the network can be tested without one.

  Carries no NuGet package references. REQ-SEC-009 requires every dependency to
  be the base class library or a project in this repository; a test framework
  would be the first exception, and the cost of doing without is about a hundred
  lines.

  The name does NOT end in '.Tests', so SpecCheck treats it as ordinary code
  rather than as a source of test coverage. It carries no requirement markers.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.TestKit</RootNamespace>
    <AssemblyName>SecretPrinter.TestKit</AssemblyName>
    <Description>Minimal dependency-free test harness for SecretPrinter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Mdns/SecretPrinter.Mdns.csproj" />
    <ProjectReference Include="../../src/SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
