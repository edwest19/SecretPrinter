<!--
  SecretPrinter.Service.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  The host: the only project that knows the whole story. Everything it uses
  knows one thing each, which is what keeps the security claims checkable a
  project at a time.

  DEPENDENCY EXCEPTION:
  This project carries the only NuGet package reference in the repository:
  System.ServiceProcess.ServiceController, which provides ServiceBase. Without
  it the service cannot register with the Windows service control manager, and
  the alternative was roughly 150 lines of hand-written interop against
  advapi32 in exactly the code path where a mistake means the printer never
  disappears from anyone's list.

  REQ-SEC-009 permits a package only when it is documented and justified in
  README.md. See the dependencies note there.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SecretPrinter.Service</RootNamespace>
    <AssemblyName>SecretPrinter.Service</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides System.ServiceProcess.ServiceBase. The only package reference
         in this repository; see the header above and README.md. -->
    <PackageReference Include="System.ServiceProcess.ServiceController">
      <Version>10.0.11</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretPrinter.Advertising/SecretPrinter.Advertising.csproj" />
    <ProjectReference Include="../SecretPrinter.Configuration/SecretPrinter.Configuration.csproj" />
    <ProjectReference Include="../SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
    <ProjectReference Include="../SecretPrinter.Mdns/SecretPrinter.Mdns.csproj" />
    <ProjectReference Include="../SecretPrinter.Proxy/SecretPrinter.Proxy.csproj" />
    <ProjectReference Include="../SecretPrinter.Resolution/SecretPrinter.Resolution.csproj" />
    <ProjectReference Include="../SecretPrinter.Responder/SecretPrinter.Responder.csproj" />
    <ProjectReference Include="../SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
