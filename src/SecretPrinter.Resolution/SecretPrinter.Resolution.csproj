<!--
  SecretPrinter.Resolution.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Finds where the real printer currently is, by asking the printer network at
  the moment the answer is needed. Separate from advertising because it faces
  the other network: this project only ever queries, and never publishes.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.Resolution</RootNamespace>
    <AssemblyName>SecretPrinter.Resolution</AssemblyName>
    <Description>Resolves the printer's current address by mDNS, on demand.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
    <ProjectReference Include="../SecretPrinter.Mdns/SecretPrinter.Mdns.csproj" />
    <ProjectReference Include="../SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
