<!--
  SecretPrinter.Spec.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Holds the [Requirement] attribute that links code and tests to the numbered
  requirements in README.md. Deliberately tiny: one attribute, no logic, no
  dependencies. Every other project - source and test alike - references this
  one, so it must stay free of anything that could pull a dependency into
  otherwise clean projects.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.Spec</RootNamespace>
    <AssemblyName>SecretPrinter.Spec</AssemblyName>
    <Description>Requirement identifiers linking SecretPrinter code to its specification.</Description>
  </PropertyGroup>

</Project>
