<!--
  SecretPrinter.Mdns.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  The service's mDNS socket layer: binds UDP 5353, joins multicast groups, and
  moves datagrams with their arrival interface. It knows nothing about printers
  or DNS record contents, which is what keeps the security claims about this
  layer checkable by reading one small project.

  References SecretPrinter.Spec for the [Requirement] markers that tie this code
  to README.md. No NuGet package references.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.Mdns</RootNamespace>
    <AssemblyName>SecretPrinter.Mdns</AssemblyName>
    <Description>mDNS socket layer for SecretPrinter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
