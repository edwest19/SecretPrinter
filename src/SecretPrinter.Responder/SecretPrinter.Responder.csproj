<!--
  SecretPrinter.Responder.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  The loop joining the two halves below it: SecretPrinter.Advertising decides
  what to publish, SecretPrinter.Mdns moves the bytes, and this decides when and
  to whom.

  It depends on both, which is why it is a separate project rather than living
  in either: SecretPrinter.Advertising must stay free of socket code so its
  security claims can be checked by reading one project.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.Responder</RootNamespace>
    <AssemblyName>SecretPrinter.Responder</AssemblyName>
    <Description>Answers mDNS queries for the names SecretPrinter advertises.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretPrinter.Advertising/SecretPrinter.Advertising.csproj" />
    <ProjectReference Include="../SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
    <ProjectReference Include="../SecretPrinter.Mdns/SecretPrinter.Mdns.csproj" />
    <ProjectReference Include="../SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
