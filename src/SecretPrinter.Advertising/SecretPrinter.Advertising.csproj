<!--
  SecretPrinter.Advertising.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Decides what the proxy publishes, and builds the DNS records for it. This is
  where Section 4 of README.md becomes code.

  Deliberately has NO dependency on SecretPrinter.Mdns and contains no socket
  code, so the question 'could this ever publish the printer's address?' is
  answerable by reading this one project.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.Advertising</RootNamespace>
    <AssemblyName>SecretPrinter.Advertising</AssemblyName>
    <Description>Decides what SecretPrinter advertises, and builds the records.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretPrinter.Dns/SecretPrinter.Dns.csproj" />
    <ProjectReference Include="../SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
