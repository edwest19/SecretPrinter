<!--
  SecretPrinter.Configuration.csproj

  Written by Claude (Anthropic model, Claude Opus 4.5) at the direction of
  Edwin West, for the SecretPrinter project.

  Loads and validates the service's settings, and resolves configured interface
  names to real adapters.

  No NuGet package references: the JSON is read with System.Text.Json's
  JsonDocument from the base class library, and inspected by hand so that every
  error message can name the exact offending setting.

  Common build settings come from Directory.Build.props at the repository root.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecretPrinter.Configuration</RootNamespace>
    <AssemblyName>SecretPrinter.Configuration</AssemblyName>
    <Description>Loads and validates SecretPrinter's configuration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SecretPrinter.Mdns/SecretPrinter.Mdns.csproj" />
    <ProjectReference Include="../SecretPrinter.Spec/SecretPrinter.Spec.csproj" />
  </ItemGroup>

</Project>
